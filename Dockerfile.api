# ── UpliftIQ backend (pipeline + FastAPI serve plane) ──────────────────────
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATA_HOME=/app/.uplift_data

WORKDIR /app

# System deps for LightGBM (libgomp).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pipeline/ ./pipeline/
COPY api/ ./api/
COPY docs/ ./docs/

# Artifact dirs (mounted as a shared volume in compose).
RUN mkdir -p models scores reports .uplift_data

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD curl -fsS http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
