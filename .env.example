# ── UpliftIQ environment configuration ─────────────────────────────────────
# Copy to ".env" and fill in. The pipeline + API run fully WITHOUT any keys
# (they fall back to local Parquet + a templated explainer). Keys upgrade the
# system: Supabase = shared score store, Gemini = LLM segment explainer.

# ── Reproducibility / pipeline ─────────────────────────────────────────────
SEED=42
DATA_HOME=./.uplift_data          # scikit-uplift download cache
DEFAULT_DATASET=hillstrom         # hillstrom | criteo
APP_ORIGIN=http://localhost:3000  # CORS origin for the API

# ── Gemini (LLM segment explainer, FR-C5) ──────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase (score store, optional) ───────────────────────────────────────
# Project Settings → API. Use the SERVICE ROLE key for the pipeline writer
# (server-side only — never ship it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SCORES_TABLE=uplift_scores

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
# Public base URL the browser uses to reach the FastAPI service.
NEXT_PUBLIC_API_BASE=http://localhost:8000
